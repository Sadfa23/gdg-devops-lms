# Postgres connection string (Neon recommended — see docs/ARCHITECTURE notes)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate a real one with: npx auth secret
AUTH_SECRET="replace-with-a-real-generated-secret"

# OAuth-only auth (no email/password, no email sending) — Google + GitHub
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# Cloudinary — public delivery for v1 (see docs/ARCHITECTURE notes on why)
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"

# Bunny Stream — video hosting (lesson recordings + blog video embeds)
BUNNY_STREAM_LIBRARY_ID="replace-with-library-id"
BUNNY_STREAM_API_KEY="replace-with-library-api-key"
BUNNY_STREAM_CDN_HOSTNAME="replace-with-pull-zone-hostname"

# Sentry — error monitoring. DSN is meant to be public, safe in a
# NEXT_PUBLIC_ var. ORG/PROJECT/AUTH_TOKEN are only needed to upload source
# maps on build; optional, app works fine without them.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Set once Topograph is deployed and the visualizer iframe is wired up.
NEXT_PUBLIC_TOPOGRAPH_URL=""

# Resend — password reset email. Free tier: 100/day, 3000/month, no card.
RESEND_API_KEY="replace-with-resend-api-key"
# Optional — defaults to Resend's shared onboarding@resend.dev address, which
# only delivers to the Resend account's own owner email. Verify a domain at
# resend.com/domains and set this once real club members need to receive it.
EMAIL_FROM=""
